# Copy this file to .env and fill in the keys. .env is gitignored.

# Google AI Studio key. Bifrost reads this variable. Never commit the real value.
GEMINI_API_KEY=

# TokenPilot sends chat completions here.
BIFROST_URL=http://localhost:8080
BIFROST_PATH=/v1/chat/completions

# Bifrost model ids. The gemini/ prefix is required.
BIFROST_SMALL_MODEL=gemini/gemini-3.5-flash-lite
BIFROST_STRONG_MODEL=gemini/gemini-3.5-flash-lite

# Optional. Used when a task needs a fact the repository does not contain.
TAVILY_API_KEY=

# Used only when a repository is marked confidential.
LOCAL_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5-coder:7b
